{
  "name": "stocker",
  "private": true,
  "version": "1.0.0",
  "description": "Personal stock portfolio tracker on Cloudflare Workers + D1",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev:api": "wrangler dev",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "test": "npm run test --workspace api",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace web",
    "db:migrate:local": "wrangler d1 migrations apply stocker --local",
    "db:migrate": "wrangler d1 migrations apply stocker --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "wrangler": "^4.120.0"
  }
}
